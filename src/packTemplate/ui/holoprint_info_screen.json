	"esbe_panel": {
		"type": "stack_panel",
		"orientation": "vertical",
		"controls": [
			{
				"i": {
					"type": "image",
					"texture": "info",
					"size": [
						"100%-16px",
						"27%x"
					]
				}
			},
			{
				"c": {
					"type": "label",
					"font_scale_factor": 1.5,
					"text": "esbe.v",
					"color": [
						0.4,
						0.8,
						0.67
					]
				}
			},
			{
				"0": {
					"type": "label",
					"text": "esbe.c0"
				}
			},
			{
				"1": {
					"type": "label",
					"text": "esbe.c1"
				}
			},
			{
				"2": {
					"type": "label",
					"text": "esbe.c2"
				}
			},
			{
				"3": {
					"type": "label",
					"text": "esbe.c3"
				}
			},
			{
				"4": {
					"type": "label",
					"text": "esbe.c4"
				}
			},
			{
				"5": {
					"type": "label",
					"text": "esbe.c5"
				}
			},
			{
				"6": {
					"type": "label",
					"text": "esbe.c6"
				}
			},
			{
				"7": {
					"type": "label",
					"text": "esbe.c7"
				}
			}
		]
	},
	"esbe_scr@common.scrolling_panel": {
		"$show_background": false,
		"$scrolling_content": "holoprint:info_screen.esbe_panel"
	},
	"esbe_fsc@common.fullscreen_header": {
		"$back_button_has_title": true,
		"$button_text": "ESBE info",
		"$child_control": "holoprint:info_screen.esbe_scr"
	},
	"esbe_main@common.base_screen": {
		"button_mappings": [
			{
				"from_button_id": "button.menu_cancel",
				"to_button_id": "button.menu_exit",
				"mapping_type": "global"
			}
		],
		"$screen_bg_content": "persona.persona_screen_background_content",
		"$screen_content": "holoprint:info_screen.esbe_fsc"
	},
	
	"open_button@common_buttons.light_content_button": {
		"size": [24, 24],
		"$pressed_button_name": "button.menu_buy_game", // what does this do
		"$button_content": "holoprint:info_screen.logo",
		"$default_button_alpha": 0.5,
		"$default_hover_alpha": 0.5
	},
	"logo": {
		"type": "image",
		"texture": "textures/holoprint/ui/logo_192",
		"size": [20, 20]
	}
	
